# Which AI analyzes the photo: gemini (free tier) or anthropic
AI_PROVIDER=gemini

# Google Gemini — get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.6-flash
# Tried in order if the main model is busy (503) or out of quota (429)
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite

# Anthropic Claude — only needed if AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Password to open the app (required when deployed; optional locally)
APP_PASSWORD=

PORT=3000

# Notion food log (optional) — see README "Food log (Notion)"
NOTION_TOKEN=
NOTION_DATABASE_ID=2919f77617474f3889d75819557817fa
